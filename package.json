{
  "name": "maestro-cli",
  "version": "0.2.0",
  "description": "Paradigm-as-Code: Multi-Agent R&D Orchestration Engine",
  "type": "module",
  "bin": {
    "maestro": "./src/index.ts"
  },
  "files": [
    "src/",
    "paradigms/",
    "prompts/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "multi-agent",
    "paradigm-as-code",
    "state-machine",
    "xstate",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhlkkk/maestro.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile=maestro",
    "dry-run:all": "bun run src/index.ts run paradigms/tdd-strict.yaml --task test --dry-run && bun run src/index.ts run paradigms/combined-workflow.yaml --task test --dry-run && bun run src/index.ts run paradigms/bug-investigation.yaml --task test --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.91",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.0",
    "xstate": "^5.19.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.0",
    "typescript": "^5.9.0"
  }
}
